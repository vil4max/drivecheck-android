<?xml version="1.0" encoding="utf-8"?>
<!-- The iOS app icon. The art fills the 72 dp square every mask shows, so no launcher crops it. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground>
        <inset
            android:drawable="@mipmap/ic_launcher_art"
            android:inset="18dp" />
    </foreground>
</adaptive-icon>
